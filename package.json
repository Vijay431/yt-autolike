{
  "private": true,
  "name": "yt-autolike",
  "description": "YT AutoLike is a privacy-first browser extension that automatically likes YouTube videos and Shorts to help support your favorite creators.",
  "version": "1.0.1",
  "keywords": [
    "youtube-extension",
    "auto-liker",
    "browser-extension",
    "youtube-shorts",
    "react-extension",
    "privacy-first",
    "productivity"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Vijay Gangatharan",
    "email": "vijayanand431@gmail.com"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "extension": "^3.18.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.9.10",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "extension dev",
    "dev:chrome": "extension dev --browser chrome",
    "dev:chromium": "extension dev --browser chromium",
    "dev:firefox": "extension dev --browser firefox",
    "dev:edge": "extension dev --browser edge",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "build:chrome": "extension build --browser chrome",
    "build:chromium": "extension build --browser chromium",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge",
    "build:all": "concurrently -n chrome,chromium,firefox,edge -c green,gray,orange,blue \"pnpm run build:chrome\" \"pnpm run build:chromium\" \"pnpm run build:firefox\" \"pnpm run build:edge\"",
    "package": "bash scripts/package-extension.sh",
    "package:chrome": "bash scripts/package-extension.sh chrome",
    "package:chromium": "bash scripts/package-extension.sh chromium",
    "package:firefox": "bash scripts/package-extension.sh firefox",
    "package:edge": "bash scripts/package-extension.sh edge",
    "package:all": "bash scripts/package-extension.sh all",
    "package:from-dist": "bash scripts/package-extension.sh from-dist",
    "package:validate": "node scripts/validate-packages.mjs",
    "chrome-webstore:upload": "node scripts/chrome-webstore-upload.mjs",
    "contributors:sync": "node scripts/sync-contributors.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build:all && pnpm run package:all && pnpm run package:validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
