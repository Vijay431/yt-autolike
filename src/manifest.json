{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 3,
  "version": "1.0.1",
  "name": "YT AutoLike",
  "description": "Automatically like YouTube videos and Shorts after watching a set percentage. Fully local — no data leaves your device.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "YT AutoLike"
  },
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": ["background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/scripts.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs"],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "host_permissions": ["*://*.youtube.com/*"],
  "author": "Vijay",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "auto-like-yt-videos@vijay.dev",
      "strict_min_version": "109.0"
    }
  },
  "firefox:data_collection_permissions": {
    "required": ["none"]
  }
}
